APP_NAME  = "Triibo Gateway HML"
APP_ENV   = local
APP_KEY   =
APP_DEBUG = true
APP_URL   = http://php-hml.triibo.com.br/

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION = mysql
DB_HOST       = 127.0.0.1
DB_PORT       = 3306
DB_DATABASE   = blog
DB_USERNAME   = root
DB_PASSWORD   =

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER       = smtp
MAIL_HOST         = msg.synoro.com.br
MAIL_PORT         = 587
MAIL_USERNAME     = "equipemarketplace@triibo.com.br"
MAIL_PASSWORD     =
MAIL_ENCRYPTION   = "TLS"
MAIL_FROM_ADDRESS = "equipemarketplace@triibo.com.br"
MAIL_FROM_NAME    = "${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

API_RATE_LIMIT_ENABLED=false

### MAUTIC / MARKETPLACE
MAUTIC_AUTH_VERSION = "OAuth2"
MAUTIC_BASE_URL     = "https://comunica.triibo.com.br"
MAUTIC_PUBLIC_KEY   =
MAUTIC_SECRET_KEY   =
MAUTIC_CALLBACK     = "${APP_URL}mautic/application/register"
PIPEDRIVE_TOKEN     =


### TRIIBO FIREBASE
### HML
TRIIBO_ENV                 = local
FIREBASE_CREDENTIALS_HML   =
FIREBASE_DATABASE_URL_HML  = "https://triibo-homol.firebaseio.com/"
### PROD
# TRIIBO_ENV                 = production
FIREBASE_CREDENTIALS_PROD  =
FIREBASE_DATABASE_URL_PROD = "https://triibo.firebaseio.com/"


### MARKETPLACE <=> FASTSHOP
### HML
MKT_ENV                          = local
WOOCOMMERCE_STORE_URL_HML        = "https://dev-marketplace.triibo.com.br/"
WOOCOMMERCE_CONSUMER_KEY_HML     =
WOOCOMMERCE_CONSUMER_SECRET_HML  =
FS_API_URL_HML                   = "https://mkp-hub.kaive.com.br/api/v1/fastshop-triibo"
FS_API_KEY_HML                   =
FS_API_TOKEN_HML                 =
WC_API_KEY_HML                   =
WC_API_TOKEN_HML                 =
### PROD
# MKT_ENV                          = production
WOOCOMMERCE_STORE_URL            = "https://marketplace.triibo.com.br/"
WOOCOMMERCE_CONSUMER_KEY         =
WOOCOMMERCE_CONSUMER_SECRET      =
WOOCOMMERCE_WP_QUERY_STRING_AUTH = true
FS_API_URL                       = "https://mkp-hub.kaive.com.br/api/v1/fastshop-triibo"
FS_API_KEY                       =
FS_API_TOKEN                     =
WC_API_KEY                       =
WC_API_TOKEN                     =


### AWIN
AWIN_ENV = local

### SOCIALSOUL
# SOCIAL_SOUL_ENV = local


### VTEX / FASTSHOP
VTEX_ENV              = local
VTEX_FS_API_KEY_HML   =
VTEX_FS_API_TOKEN_HML =
VTEX_FS_API_KEY_PRD   =
VTEX_FS_API_TOKEN_PRD =
