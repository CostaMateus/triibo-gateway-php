{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "codexshaper/laravel-woocommerce": "^3.0",
        "costamateus/laravel-mautic-api": "^3.0",
        "davidhsianturi/blade-bootstrap-icons": "^1.1",
        "devio/pipedrive": "^2.10",
        "gregwar/image": "^2.1",
        "guzzlehttp/guzzle": "^7.3",
        "kreait/laravel-firebase": "^5.0",
        "laravel/framework": "^10.0",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^4.0",
        "lucascudo/laravel-pt-br-localization": "^1.1",
        "opcodesio/log-viewer": "^2.5"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.9",
        "lucascudo/laravel-pt-br-localization": "^1.1",
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/Helpers/Functions.php",
            "app/Helpers/Helper.php",
            "app/Helpers/Vtex.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
